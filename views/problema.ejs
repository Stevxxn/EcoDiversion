<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-5">
    <h2 class="text-center mb-5" data-aos="fade-down">El Desafío y Nuestra Propuesta</h2>
    
    <div class="row align-items-stretch">
        <div class="col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
            <div class="card border-danger h-100 shadow-sm">
                <div class="card-header bg-danger text-white fw-bold">El Problema</div>
                <div class="card-body">
                    <p class="card-text"><%= problema %></p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4" data-aos="fade-up" data-aos-delay="300">
            <div class="card border-success h-100 shadow-sm">
                <div class="card-header bg-success text-white fw-bold">La Solución EcoDiversión</div>
                <div class="card-body">
                    <p class="card-text"><%= solucion %></p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>